# 서버 전용 환경변수 — 복사해서 .env.local 로 만든 뒤 값을 채운다
# NEXT_PUBLIC_ 접두사를 붙이지 않는다
# AI API 키는 사용하지 않는다 (프롬프트를 복사해 ChatGPT 등에서 직접 실행)

# Notion Integration 토큰
NOTION_API_KEY=
# 분석 대상 포트폴리오 페이지 ID (하위 페이지를 이력서·지원서 문서로 읽는다)
NOTION_PORTFOLIO_PAGE_ID=

# 접근 제한(HTTP Basic 인증): /resume, /api/resume 보호
# 배포 환경에서는 둘 다 설정해야 접속할 수 있다 (미설정이면 접속 차단). 비밀번호는 8자 이상
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
